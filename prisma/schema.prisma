generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { CUSTOMER ORGANISER ADMIN }
enum EventType { MOVIE CONCERT OTHER }
enum SeatCategory { PREMIUM STANDARD VIP }
enum SeatStatus { AVAILABLE HELD BOOKED }
enum BookingStatus { CONFIRMED CANCELLED }
enum WaitlistStatus { WAITING OFFERED CONVERTED EXPIRED CANCELLED }

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(CUSTOMER)
  bookings Booking[]
  holds ShowSeat[] @relation("SeatHolder")
  waitlistEntries WaitlistEntry[]
  offers WaitlistOffer[]
  createdAt DateTime @default(now())
}

model Venue {
  id String @id @default(cuid())
  name String
  city String
  rows Int
  seatsPerRow Int
  seats Seat[]
  events Event[]
  createdAt DateTime @default(now())
}

model Seat {
  id String @id @default(cuid())
  venueId String
  rowLabel String
  seatNumber Int
  category SeatCategory
  venue Venue @relation(fields:[venueId], references:[id], onDelete:Cascade)
  showSeats ShowSeat[]
  @@unique([venueId,rowLabel,seatNumber])
  @@index([venueId,category])
}

model Event {
  id String @id @default(cuid())
  title String
  description String?
  type EventType
  venueId String
  startsAt DateTime
  endsAt DateTime?
  published Boolean @default(true)
  premiumPrice Int
  standardPrice Int
  vipPrice Int
  venue Venue @relation(fields:[venueId], references:[id])
  showSeats ShowSeat[]
  bookings Booking[]
  waitlistEntries WaitlistEntry[]
  createdAt DateTime @default(now())
  @@index([startsAt,published])
}

model ShowSeat {
  id String @id @default(cuid())
  eventId String
  seatId String
  status SeatStatus @default(AVAILABLE)
  heldById String?
  holdToken String? @unique
  holdExpiresAt DateTime?
  bookedAt DateTime?
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  seat Seat @relation(fields:[seatId], references:[id], onDelete:Cascade)
  heldBy User? @relation("SeatHolder", fields:[heldById], references:[id])
  bookingItems BookingItem[]
  @@unique([eventId,seatId])
  @@index([eventId,status])
  @@index([eventId,holdExpiresAt])
}

model Booking {
  id String @id @default(cuid())
  reference String @unique
  userId String
  eventId String
  status BookingStatus @default(CONFIRMED)
  totalAmount Int
  idempotencyKey String @unique
  qrPayload String?
  user User @relation(fields:[userId], references:[id])
  event Event @relation(fields:[eventId], references:[id])
  items BookingItem[]
  createdAt DateTime @default(now())
  cancelledAt DateTime?
  @@index([userId,createdAt])
  @@index([eventId,status])
}

model BookingItem {
  id String @id @default(cuid())
  bookingId String
  showSeatId String
  price Int
  booking Booking @relation(fields:[bookingId], references:[id], onDelete:Cascade)
  showSeat ShowSeat @relation(fields:[showSeatId], references:[id])
  @@unique([bookingId,showSeatId])
}

model WaitlistEntry {
  id String @id @default(cuid())
  userId String
  eventId String
  category SeatCategory
  status WaitlistStatus @default(WAITING)
  joinedAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  offers WaitlistOffer[]
  @@unique([userId,eventId,category])
  @@index([eventId,category,status,joinedAt])
}

model WaitlistOffer {
  id String @id @default(cuid())
  entryId String
  userId String
  eventId String
  showSeatId String
  expiresAt DateTime
  status WaitlistStatus @default(OFFERED)
  entry WaitlistEntry @relation(fields:[entryId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([eventId,showSeatId,status])
  @@index([expiresAt,status])
}
